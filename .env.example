# Server-side secrets — set these in your hosting platform's environment
# variables (never commit real values to git).

# Groq API key (https://console.groq.com/keys) — powers the article explainer
GROQ_API_KEY=

# Hugging Face token (https://huggingface.co/settings/tokens) with
# "Make calls to Inference Providers" permission — powers semantic search
HF_TOKEN=
